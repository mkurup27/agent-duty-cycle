# Copy to .env and fill in. Never commit .env.
# Managed Postgres (same region as the Functions namespace)
DATABASE_URL=postgresql://doadmin:PASSWORD@HOST:25060/defaultdb
# Paste the cluster CA certificate on one line with literal \n, or leave empty
PG_CA_CERT=
# Spaces bucket (same region)
SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
SPACES_REGION=nyc3
SPACES_BUCKET=dc-agent-state
SPACES_KEY=
SPACES_SECRET=
# DO Serverless Inference
MODEL_BASE_URL=https://inference.do-ai.run/v1
MODEL_ID=
MODEL_ACCESS_KEY=
